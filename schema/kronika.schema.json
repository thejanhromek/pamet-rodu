{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/rodova-kronika/kronika.schema.json",
  "title": "Rodová kronika – datový soubor",
  "description": "Schéma hlavního datového souboru kroniky (viz docs/data-contract.md). Neznámá pole jsou povolená, aby šlo data rozšiřovat; typy, povinná pole, ID a výčty se kontrolují.",
  "type": "object",
  "required": ["meta", "people", "relationships", "events", "places", "claims", "sources", "media"],
  "properties": {
    "meta": {
      "type": "object",
            "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "updatedAt": { "$ref": "#/$defs/isoDay" },
        "defaultPersonId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "feedback": { "type": "object", "properties": { "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" } } },
        "mapView": {
          "type": "object",
          "properties": {
            "initialBounds": {
              "type": "object",
              "required": ["south", "north", "west", "east"],
              "properties": {
                "south": { "type": "number", "minimum": -90, "maximum": 90 },
                "north": { "type": "number", "minimum": -90, "maximum": 90 },
                "west": { "type": "number", "minimum": -180, "maximum": 180 },
                "east": { "type": "number", "minimum": -180, "maximum": 180 }
              }
            }
          }
        },
        "evidenceLabels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "media": { "type": "array", "items": { "$ref": "#/$defs/media" } },
    "researchTasks": { "type": "array", "items": { "$ref": "#/$defs/researchTask" } },
    "changelog": { "type": "array", "items": { "$ref": "#/$defs/change" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "items": { "type": "string" } },
    "date": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$" },
    "isoDay": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "evidence": { "enum": ["verified", "supported", "family-record", "hypothesis"] },
    "url": { "type": "string", "pattern": "^https?://" },
    "lifeEvent": {
      "type": "object",
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "dateText": { "type": "string" },
        "placeId": { "$ref": "#/$defs/id" },
        "placeText": { "type": "string" }
      }
    },
    "person": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/text" },
        "surnames": { "$ref": "#/$defs/texts" },
        "aliases": { "$ref": "#/$defs/texts" },
        "sex": { "enum": ["male", "female", "unknown"] },
        "lineage": { "enum": ["self", "direct", "collateral", "affinal", "unlinked", "unknown"] },
        "branch": { "$ref": "#/$defs/texts" },
        "birth": { "$ref": "#/$defs/lifeEvent" },
        "death": { "$ref": "#/$defs/lifeEvent" },
        "residences": { "$ref": "#/$defs/texts" },
        "occupations": { "$ref": "#/$defs/texts" },
        "notes": { "$ref": "#/$defs/texts" },
        "familyNotes": { "$ref": "#/$defs/texts" },
        "sourceIds": { "$ref": "#/$defs/ids" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["parent-child", "spouse", "sibling"] },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sourceIds": { "$ref": "#/$defs/ids" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "title": { "$ref": "#/$defs/text" },
        "date": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "dateText": { "type": "string" },
        "placeId": { "$ref": "#/$defs/id" },
        "fromPlaceId": { "$ref": "#/$defs/id" },
        "placeText": { "type": "string" },
        "personIds": { "$ref": "#/$defs/ids" },
        "sourceIds": { "$ref": "#/$defs/ids" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "details": { "type": "string" },
        "notes": { "$ref": "#/$defs/texts" }
      }
    },
    "place": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "country": { "type": "string" },
        "region": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "houseNumbers": { "$ref": "#/$defs/texts" },
        "coordinatesStatus": { "type": "string" },
        "coordinateSource": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "url": { "$ref": "#/$defs/url" },
            "license": { "type": "string" },
            "licenseUrl": { "$ref": "#/$defs/url" },
            "retrievedAt": { "$ref": "#/$defs/isoDay" }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "subjectType", "subjectId", "text", "evidence", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjectType": { "enum": ["person", "relationship", "couple", "branch", "place", "event", "source"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "text": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "reasoning": { "type": "string" },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "type": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "publisher": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "relatedUrls": { "type": "array", "items": { "$ref": "#/$defs/url" } },
        "accessedAt": { "type": "string" },
        "origin": { "type": "string" },
        "reliabilityNote": { "type": "string" },
        "transcriptionLines": { "$ref": "#/$defs/texts" },
        "cueCount": { "type": "integer", "minimum": 0 }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "kind", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["face", "text"] },
        "personId": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "media": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "title": { "$ref": "#/$defs/text" },
        "file": { "type": "string", "minLength": 1 },
        "sourceId": { "$ref": "#/$defs/id" },
        "personIds": { "$ref": "#/$defs/ids" },
        "interview": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "speaker": { "type": "string" },
        "quote": { "type": "string" },
        "words": { "type": "array", "items": { "type": "array" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "researchTask": {
      "type": "object",
      "required": ["id", "title", "priority", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "status": { "enum": ["open", "in-progress", "in_progress", "closed"] },
        "expectedPayoff": { "type": "string" },
        "nextAction": { "type": "string" },
        "personIds": { "$ref": "#/$defs/ids" },
        "sourceIds": { "$ref": "#/$defs/ids" }
      }
    },
    "change": {
      "type": "object",
      "required": ["id", "date", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/isoDay" },
        "title": { "$ref": "#/$defs/text" },
        "categories": { "$ref": "#/$defs/texts" },
        "items": { "$ref": "#/$defs/texts" }
      }
    },
    "companions": {
      "gazetteer": {
        "type": "object",
        "required": ["places"],
        "properties": {
          "places": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "historicalNames": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/text" }, "lang": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" } } } },
                "jurisdictions": { "type": "array", "items": { "type": "object", "required": ["type", "name"], "properties": { "type": { "enum": ["parish", "estate", "judicial-district", "political-district", "region"] }, "name": { "$ref": "#/$defs/text" } } } },
                "links": { "type": "array", "items": { "type": "object", "required": ["title", "url"], "properties": { "url": { "$ref": "#/$defs/url" } } } },
                "sources": { "type": "array", "items": { "type": "object", "required": ["title", "url"], "properties": { "url": { "$ref": "#/$defs/url" } } } }
              }
            }
          }
        }
      },
      "registers": {
        "type": "object",
        "required": ["registers"],
        "properties": {
          "registers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "parish", "placeIds", "kinds", "from", "to"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "placeIds": { "$ref": "#/$defs/ids" },
                "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["N", "O", "Z"] } },
                "from": { "type": "integer" },
                "to": { "type": "integer" },
                "index": { "type": "boolean" },
                "url": { "$ref": "#/$defs/url" }
              }
            }
          }
        }
      },
      "mediaNotes": {
        "type": "object",
        "required": ["media"],
        "properties": {
          "media": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "date": { "$ref": "#/$defs/date" },
                "dateText": { "type": "string" },
                "dateEvidence": { "$ref": "#/$defs/evidence" },
                "dateReasoning": { "type": "string" },
                "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
              }
            }
          }
        }
      },
      "historyLocal": {
        "type": "object",
        "required": ["events"],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "date", "title", "summary", "placeIds", "sources"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "date": { "$ref": "#/$defs/date" },
                "endDate": { "$ref": "#/$defs/date" },
                "placeIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
                "scope": { "enum": ["obec", "panstvi", "okres"] },
                "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title", "url"], "properties": { "url": { "type": "string", "pattern": "^https://" } } } }
              }
            }
          }
        }
      }
    }
  }
}
